# Copy to .env and fill in whatever you have — every key is optional;
# providers with no key are simply skipped by the router.
OPENROUTER_KEY=
FREEINFERENCE_KEY=
CLOUDFLARE_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
NVIDIA_KEY=
GROQ_KEY=
PORT=8080

# --- server auth (REQUIRED for any non-loopback bind) ------------------------
# docker-compose.yml binds HOST=0.0.0.0, and server.py REFUSES to start on a
# non-loopback address without this token (exit 2) — an exposed server with no
# token is an open LLM proxy spending your provider keys. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Clients then send:  Authorization: Bearer <token>
# Leave HOST at 127.0.0.1 and this can stay empty.
FLIPPY_AUTH_TOKEN=
# HOST=127.0.0.1

# Telegram alert delivery for loomweaver observability (optional).
# Set both to push real-time alerts; leave unset to file-log only.
LOOMWEAVER_TELEGRAM_BOT_TOKEN=
LOOMWEAVER_TELEGRAM_CHAT_ID=

# --- zero-trust operator switches ---
# Kill-switch: set to 1 to HARD-DISABLE all agent tool execution live
# (read each dispatch, not import-time). Close a compromised run immediately:
#   FLIPPY_KILL_SWITCH=1
# Alias:
#   LOOMWEAVER_EMERGENCY_OFF=1
# Re-enable cron scheduling of the tool-running agent (NOT recommended; default
# is to refuse agent/armada jobs entirely):
#   LOOMWEAVER_CRON_ALLOW_AGENT=1

# --- bring-your-OWN OpenAI/Anthropic-compatible endpoint (no brand required) ---
# This pair owns the provider name `custom`. flippy speaks the OpenAI
# chat/completions wire format, so ANY endpoint that does too works here.
OPENAI_API_BASE=https://your-gateway/v1
OPENAI_API_KEY=sk-...
OPENAI_MODELS=gpt-4o,claude-sonnet-4
# or Anthropic-via-compatible-gateway:
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=

# --- any other provider: just add its key ---------------------------------
# Each of these registers itself the moment its key is set. Nothing else to
# configure; add <NAME>_MODELS=a,b to override the model list for any of them.
#   flippy providers --all     <- full catalog + the variable that enables each
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
DEEPINFRA_API_TOKEN=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=
XAI_API_KEY=
PERPLEXITY_API_KEY=
MOONSHOT_API_KEY=
DASHSCOPE_API_KEY=
SILICONFLOW_API_KEY=
HF_TOKEN=

# --- local / self-hosted (no key; enabled by the base URL) ------------------
OLLAMA_BASE_URL=            # e.g. http://localhost:11434
LMSTUDIO_BASE_URL=          # e.g. http://localhost:1234
VLLM_BASE_URL=              # e.g. http://localhost:8000

# --- a provider flippy has never heard of ----------------------------------
# Any <PREFIX>_API_KEY + <PREFIX>_BASE_URL pair registers itself as <prefix>.
# No code change, no catalog entry. Suffixes accepted: _API_KEY, _APIKEY,
# _KEY, _TOKEN. Endpoints: _BASE_URL, _API_BASE, _BASE, _ENDPOINT, _URL.
#   ACME_API_KEY=ak_live_...
#   ACME_BASE_URL=https://llm.acme.io/v1
#   ACME_MODELS=acme-large,acme-mini
# Or a JSON catalog for anything the env conventions cannot express:
#   FLIPPY_PROVIDERS_JSON=/etc/flippy/providers.json
# Or explicit numbered endpoints:
#   FLIPPY_PROVIDER_1_NAME=bank-llm
#   FLIPPY_PROVIDER_1_BASE_URL=https://internal.bank/v1
#   FLIPPY_PROVIDER_1_API_KEY=
#   FLIPPY_PROVIDER_1_MODELS=bank-7b

# --- self-learning memory ---------------------------------------------------
# flippy records routing outcomes and agent runs so routing improves across
# restarts, and files a lesson from every failure or correction. Local SQLite,
# nothing leaves the machine.
#   LOOMWEAVER_LEARNING_ENABLED=0        disable entirely
#   LOOMWEAVER_LEARNING_DB=/var/lib/flippy/learning.db   relocate the store
# Inspect and teach it:
#   flippy profile                       what it has inferred about you
#   flippy learn "when I say deploy, run migrations first"
#   flippy forget --all
